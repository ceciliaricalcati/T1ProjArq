@startuml c4-2-conteineres
!include <C4/C4_Container>

title C4 Nível 2: Contêineres

Person(operador, "Operador / Cliente da API", "Usa uma ferramenta HTTP para chamar a API")

System_Boundary(sistema, "Sistema de Gestão de Planos de Voo") {
    Container(api, "API Backend", "Java 21, Spring Boot 3.4", "Expõe a API REST (com OpenAPI/Swagger UI), aplica as regras de negócio, orquestra transações de aprovação e cancelamento e executa a carga inicial de dados.")
    ContainerDb(banco, "Banco de dados", "PostgreSQL 16 (Docker Compose)", "Persiste rede aérea, pilotos, aeronaves, planos, trechos e reservas. Garante unicidade das reservas por restrições UNIQUE. O esquema é versionado pelo Flyway.")
}

Rel(operador, api, "Chama os endpoints", "HTTP/JSON")
Rel(api, banco, "Lê e grava dados em transações", "JDBC")

@enduml
